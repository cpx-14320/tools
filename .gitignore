# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# 一次性腳本的輸出報告（終端機是 cp950，中文直接印會亂碼，所以寫成檔案再看）
scripts/.*-report.txt
scripts/.inventory.txt

# 丟在 public/ 底下的參考素材（zip、ChatGPT 產的參考圖）。public/ 會被公開提供下載，
# 這些東西不該進版本控制，也不該被部署出去。
public/**/*.zip
public/**/ChatGPT*
